{
  "openapi": "3.0.4",
  "info": {
    "title": "MovieService API",
    "version": "v1"
  },
  "paths": {
    "/api/Movies/search": {
      "get": {
        "tags": [
          "Movies"
        ],
        "parameters": [
          {
            "name": "q",
