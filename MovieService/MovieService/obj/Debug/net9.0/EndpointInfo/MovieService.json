              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Movies/bulk": {
      "post": {
        "tags": [
          "Movies"
        ],
        "requestBody": {
