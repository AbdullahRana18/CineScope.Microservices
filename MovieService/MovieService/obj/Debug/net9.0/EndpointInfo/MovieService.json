            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdsRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/IdsRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/IdsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
