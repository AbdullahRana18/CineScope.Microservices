@model List<MovieWebUI.Controllers.UserDto>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "User Directory";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">User Directory</h2>
            <p class="text-muted small mb-0">List of all registered accounts in the system.</p>
        </div>
        <div>
            <span class="badge bg-white text-dark border shadow-sm p-2 px-3 rounded-pill">
                <i class="bi bi-people me-1"></i> Total Users: @Model.Count()
            </span>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4 text-uppercase small fw-bold" style="width: 40%;">User Profile</th>
                            <th class="text-uppercase small fw-bold" style="width: 40%;">Email Address</th>
                            <th class="text-uppercase small fw-bold text-center" style="width: 20%;">Current Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-light text-primary me-3">
                                            <span class="fw-bold fs-5">@user.Username.Substring(0, 1).ToUpper()</span>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@user.Username</span>
                                            <span class="small text-muted">ID: #@user.Id</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-envelope me-2 small"></i>
                                        @user.Email
                                    </div>
                                </td>

                                <td class="text-center">
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                            <i class="bi bi-shield-check me-1"></i> Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                                            <i class="bi bi-person me-1"></i> User
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styling for the User Avatar Circle */
    .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f0f2f5;
    }

    /* Soft Badge Colors (Professional Look) */
    .bg-success-subtle {
        background-color: #e6f6ee !important;
        color: #0f5132 !important;
    }

    .bg-primary-subtle {
        background-color: #e7f1ff !important;
        color: #0d6efd !important;
    }

    /* Slight row hover effect */
    .table-hover tbody tr:hover {
        background-color: #fafbfc;
    }
</style>