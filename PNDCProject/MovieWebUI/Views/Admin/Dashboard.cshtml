@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-3">
    <!-- g-3 adds responsive spacing between cards -->
    <div class="col-12 col-sm-6 col-md-3">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <h5 class="card-title">Total Users</h5>
                <p class="card-text fs-4 fw-bold" id="totalUsers">Loading...</p>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-md-3">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <h5 class="card-title">Total Movies</h5>
                <p class="card-text fs-4 fw-bold" id="totalMovies">1500</p>
            </div>
        </div>
    </div>
</div>

<script>
    const authApiBase = "https://localhost:7016/api/Auth/";
    const movieApiBase = "https://localhost:7288/api/Movies/";

    // ✅ Get JWT token from session
    const token = '@Context.Session.GetString("token")';

    // ✅ Fetch total users from AuthService
    fetch(authApiBase + "users", {
        headers: {
            "Authorization": `Bearer ${token}`
        }
    })
    .then(res => {
        if (!res.ok) throw new Error("Users API Error: " + res.statusText);
        return res.json();
    })
    .then(data => {
        document.getElementById("totalUsers").innerText = data.length;
    })
    .catch(err => {
        console.error("Users API Error:", err);
        document.getElementById("totalUsers").innerText = "Error";
    });

  
    document.getElementById("totalMovies").innerText = "995";
</script>
