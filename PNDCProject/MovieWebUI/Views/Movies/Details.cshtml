@model MovieWebUI.Models.MovieDto

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Image with fixed max height and responsive width -->
        <img src="https://image.tmdb.org/t/p/w500/@Model.PosterPath"
             class="img-fluid"
             style="max-height: 500px; width: auto; display: block; margin: 0 auto;"
             alt="@Model.Title" />

        <div class="card-body">
            <h2 class="fw-bold">@Model.Title</h2>
            <p class="mt-3">@Model.Overview</p>
            <p class="mt-2">
                <strong>Release Date:</strong> @Model.ReleaseDate
            </p>

            <!-- Back button -->
            <a asp-controller="Movies" asp-action="Index"
               class="btn btn-primary mt-3 rounded-pill">
                Back to Movies
            </a>
        </div>
    </div>
</div>
