@model MovieWebUI.Models.MovieDto

@{
    ViewData["Title"] = Model.Title;
    // Extract year for the badge
    var releaseYear = DateTime.TryParse(Model.ReleaseDate, out var date) ? date.Year.ToString() : "N/A";
}

<div class="container py-5">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mx-auto" style="max-width: 1000px;">
        <div class="row g-0">

            <div class="col-md-5 col-lg-4 bg-light position-relative">
                <img src="https://image.tmdb.org/t/p/w500/@Model.PosterPath"
                     class="img-fluid w-100 h-100 object-fit-cover"
                     alt="@Model.Title"
                     style="min-height: 400px;" />

                <div class="d-md-none position-absolute bottom-0 start-0 w-100 h-25 bg-gradient-to-top"></div>
            </div>

            <div class="col-md-7 col-lg-8">
                <div class="card-body p-4 p-lg-5 d-flex flex-column h-100">

                    <div class="mb-4">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                            <h1 class="display-5 fw-bold text-dark lh-1 mb-0">@Model.Title</h1>
                            <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                                @releaseYear
                            </span>
                        </div>
                        <p class="text-muted mt-2 mb-0">
                            <i class="bi bi-calendar-event me-2"></i> Released: @Model.ReleaseDate
                        </p>
                    </div>

                    <hr class="text-muted opacity-25 my-2">

                    <div class="py-3 flex-grow-1">
                        <h5 class="text-uppercase text-primary fw-bold small letter-spacing-1">Plot Summary</h5>
                        <p class="lead text-secondary" style="font-size: 1.1rem; line-height: 1.8;">
                            @Model.Overview
                        </p>
                    </div>

                    <div class="mt-auto pt-4 d-flex gap-3">
                        <a asp-controller="Movies" asp-action="Index"
                           class="btn btn-outline-dark btn-lg px-4 rounded-pill shadow-sm transition-btn">
                            <i class="bi bi-arrow-left me-2"></i> Back to Movies
                        </a>

                        <button class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm transition-btn">
                            <i class="bi bi-play-fill me-1"></i> Watch Trailer
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* 1. Object Fit Cover:
           Ensures the poster fills the left column without stretching,
           acting like a sidebar image on desktop.
        */
    .object-fit-cover {
        object-fit: cover;
    }

    /* 2. Typography Tweaks */
    .letter-spacing-1 {
        letter-spacing: 1px;
    }

    /* 3. Button Hover Effects */
    .transition-btn {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
        }

    /* 4. Responsive Image Height */
    @@media (max-width: 768px) {
        /* On mobile, limit image height so it doesn't take up the whole screen */
        .object-fit-cover {
            max-height: 500px;
            object-position: top center;
        }
    }
</style>