@model List<MovieWebUI.Models.MovieDto>
@{
    ViewData["Title"] = "Movies";
}

<div class="container mt-4">

    <!-- Search Form at top -->
    <form method="get" class="mb-4 d-flex justify-content-center">
        <input type="text" name="searchQuery" class="form-control w-50 me-2" placeholder="Search movies..."
               value="@ViewData["SearchQuery"]" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <!-- Trending Movies Heading -->
    <h2 class="mb-4">Trending Movies</h2>

    <!-- Movies Grid -->
    <div class="row">
        @foreach (var movie in Model)
        {
            <div class="col-md-3 mb-4 movie-card">
                <div class="card h-100 shadow-sm">
                    <img class="card-img-top" src="https://image.tmdb.org/t/p/w500/@movie.PosterPath" alt="@movie.Title" style="height: 350px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@movie.Title</h5>
                        <p class="card-text text-truncate" style="flex-grow:1;">@movie.Overview</p>
                        <p class="mb-0"><strong>Release:</strong> @movie.ReleaseDate</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
