@model List<MovieWebUI.Models.MovieDto>
@{
    ViewData["Title"] = "Discover Movies";
    // Variable ka naam change kiya 'currentQuery' taake conflict na ho
    var currentQuery = ViewData["SearchQuery"]?.ToString();
}

<div class="container py-5">

    <div class="row justify-content-center mb-5">
        <div class="col-lg-8 text-center">
            <h1 class="fw-bold display-5 mb-3 text-dark">Discover Movies</h1>
            <p class="text-muted mb-4">Explore the latest trending films and search for your favorites.</p>

            <form method="get" class="position-relative">
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden bg-white border">
                    <span class="input-group-text bg-white border-0 ps-4 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchQuery" class="form-control border-0 shadow-none ps-2"
                           placeholder="Search for movies (e.g. Batman, Inception)..."
                           value="@currentQuery" autocomplete="off" />
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex align-items-center mb-4">
        <div class="flex-grow-1">
            @if (string.IsNullOrWhiteSpace(currentQuery))
            {
                <h3 class="fw-bold text-dark border-start border-4 border-primary ps-3">Trending Now</h3>
            }
            else
            {
                <h3 class="fw-bold text-dark">
                    Results for: <span class="text-primary">"@currentQuery"</span>
                </h3>
                <a href="/Movies" class="btn btn-sm btn-link text-decoration-none text-muted">Clear Search</a>
            }
        </div>
        <span class="badge bg-light text-dark border">
            @((Model?.Count ?? 0)) Movies Found
        </span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-3 text-muted opacity-25">
                <i class="bi bi-film" style="font-size: 5rem;"></i>
            </div>
            <h4 class="fw-bold text-muted">No movies found</h4>
            <p class="text-muted">Try adjusting your search terms or check back later.</p>
            <a href="/Movies" class="btn btn-outline-primary mt-2">View All Movies</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden movie-card group">

                        <div class="position-relative overflow-hidden poster-container">
                            <img src="https://image.tmdb.org/t/p/w500/@movie.PosterPath"
                                 class="card-img-top w-100 h-100 object-fit-cover transition-transform"
                                 alt="@movie.Title"
                                 loading="lazy" />

                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-dark bg-opacity-75 backdrop-blur shadow-sm">
                                    @(DateTime.TryParse(movie.ReleaseDate, out var date) ? date.Year.ToString() : "N/A")
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-dark text-truncate mb-2" title="@movie.Title">
                                @movie.Title
                            </h6>

                            <p class="card-text small text-muted flex-grow-1 description-clamp">
                                @movie.Overview
                            </p>

                            <a href="/Movies/Details/@movie.Id" class="btn btn-light btn-sm w-100 text-primary fw-bold mt-2 stretched-link hover-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* 1. Poster Aspect Ratio */
    .poster-container {
        height: 320px;
        background-color: #f0f0f0;
    }

    /* 2. Hover Animations */
    .movie-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background-color: #fff;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

            .movie-card:hover .card-img-top {
                transform: scale(1.05);
            }

    .transition-transform {
        transition: transform 0.4s ease;
    }

    /* 3. Text Truncation (3 lines max) */
    .description-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    /* 4. Button Hover Effect */
    .movie-card:hover .hover-primary {
        background-color: #0d6efd;
        color: white !important;
    }

    .backdrop-blur {
        backdrop-filter: blur(4px);
    }
</style>