@model List<MovieWebUI.Models.MovieDto>
@{
    ViewData["Title"] = "Movies";
    var searchQuery = ViewData["SearchQuery"]?.ToString();
}

<div class="container mt-4">

    <!-- Search Form at top -->
    <form method="get" class="mb-5 d-flex justify-content-center">
        <input type="text" name="searchQuery" class="form-control w-50 me-2 shadow-sm rounded-pill"
               placeholder="Search movies..." value="@ViewData["SearchQuery"]" />
        <button type="submit" class="btn btn-primary shadow-sm rounded-pill">Search</button>
    </form>

    <!-- Trending or Search Heading -->
    <div class="mb-4 text-center">
        @if (string.IsNullOrWhiteSpace(searchQuery))
        {
            <h2 class="fw-bold text-secondary">Trending Movies</h2>
        }
        else
        {
            <h2 class="fw-bold text-primary">Search Results for: <span class="text-dark">@searchQuery</span></h2>
        }
    </div>

    <!-- No Movies Found -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center fs-5 shadow-sm">
            Sorry! This movie does not exist.
        </div>
    }
    else
    {
        <!-- Movies Grid -->
        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden movie-card">
                        <img class="card-img-top" src="https://image.tmdb.org/t/p/w500/@movie.PosterPath" alt="@movie.Title" style="height: 350px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate fw-bold">@movie.Title</h5>
                            <p class="card-text text-truncate" style="flex-grow:1;">@movie.Overview</p>
                            <p class="mb-0"><strong>Release:</strong> @movie.ReleaseDate</p>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <button class="btn btn-outline-primary w-100 rounded-pill">View Details</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Hover effect for movie cards */
    .movie-card:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
    }

    .card-title {
        font-size: 1.1rem;
    }

    .card-text {
        font-size: 0.9rem;
    }

    .btn-outline-primary:hover {
        background-color: #0d6efd;
        color: #fff;
        transition: 0.3s;
    }
</style>
