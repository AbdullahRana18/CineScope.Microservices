@model List<MovieWebUI.Models.MovieDto>

@{
    ViewData["Title"] = "Parallel Bulk Fetch";
}

<style>
    /* Custom Animations & Hover Effects */
    .movie-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        background: #fff;
    }

        .movie-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .card-img-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .badge-id {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        color: #fff;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        z-index: 2;
    }

    .fade-in {
        animation: fadeIn 0.6s ease-in-out;
    }

    /* Style for the recommended ID chips */
    .id-chip {
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid #dee2e6;
        background: #fff;
    }

        .id-chip:hover {
            background-color: #f8f9fa;
            transform: scale(1.05);
            border-color: #ffc107;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container-fluid px-4 mt-4 fade-in">

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-dark d-flex align-items-center gap-2">
                <span class="text-warning"><i class="bi bi-lightning-charge-fill"></i></span>
                High Performance Bulk Fetch
            </h2>
            <p class="text-muted mb-0">
                Execute <span class="badge bg-light text-dark border">Parallel Tasks</span> to fetch multiple movie datasets simultaneously.
            </p>
        </div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
                <div class="card-body p-4 bg-white">
                    <form asp-action="BulkDemo" method="post" id="bulkForm">
                        <label class="form-label fw-bold text-secondary text-uppercase small mb-2">Enter Movie IDs</label>

                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden border">
                            <span class="input-group-text bg-white border-0 ps-3">
                                <i class="bi bi-search text-warning"></i>
                            </span>
                            <input type="text" class="form-control border-0 py-3" id="movieIdsInput" name="movieIds"
                                   placeholder="e.g. 550, 299536, 155" required style="font-size: 1.1rem; letter-spacing: 0.5px;">
                            <button type="submit" class="btn btn-warning px-4 fw-bold text-dark" style="z-index: 5;">
                                Fetch Data
                            </button>
                        </div>

                        <div class="mt-3 d-flex align-items-center flex-wrap gap-2">
                            <small class="text-muted fw-bold me-2"><i class="bi bi-stars text-warning"></i> Try these:</small>

                            <span class="badge rounded-pill text-dark p-2 px-3 id-chip" onclick="fillInput('550, 299536, 155')">
                                <i class="bi bi-plus-circle me-1"></i> Popular Mix
                            </span>
                            <span class="badge rounded-pill text-dark p-2 px-3 id-chip" onclick="fillInput('299536, 299534, 284054')">
                                <i class="bi bi-plus-circle me-1"></i> Marvel Pack
                            </span>
                            <span class="badge rounded-pill text-dark p-2 px-3 id-chip" onclick="fillInput('155, 49026, 49051')">
                                <i class="bi bi-plus-circle me-1"></i> Dark Knight Trilogy
                            </span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-3 d-flex align-items-center fade-in mx-auto" style="max-width: 900px;">
            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
            <div>
                <strong>Error:</strong> @ViewBag.Error
            </div>
        </div>
    }

    @if (Model != null && Model.Count > 0)
    {
        <div class="d-flex align-items-center justify-content-between mb-3 fade-in mx-auto" style="max-width: 1400px;">
            <h5 class="fw-bold text-secondary">Results <span class="badge bg-primary rounded-pill ms-2">@Model.Count Found</span></h5>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-5 fade-in mx-auto" style="max-width: 1400px;">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="card h-100 movie-card shadow-sm rounded-4 position-relative">
                        <span class="badge-id">ID: @movie.Id</span>

                        <div class="card-img-wrapper" style="height: 380px;">
                            @if (!string.IsNullOrEmpty(movie.PosterPath))
                            {
                                <img src="https://image.tmdb.org/t/p/w500/@movie.PosterPath" class="w-100 h-100" alt="@movie.Title" style="object-fit: cover;">
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center bg-light h-100 text-muted">
                                    <i class="bi bi-image fs-1 opacity-50"></i>
                                    <span class="small mt-2">No Poster</span>
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@movie.Title">
                                @movie.Title
                            </h6>
                            <small class="text-muted mb-3 d-block">
                                <i class="bi bi-calendar-event me-1"></i> @(string.IsNullOrEmpty(movie.ReleaseDate) ? "N/A" : movie.ReleaseDate)
                            </small>

                            <p class="card-text text-secondary small flex-grow-1" style="line-height: 1.5;">
                                @movie.Overview?.Substring(0, Math.Min(90, movie.Overview?.Length ?? 0))...
                            </p>

                            <a href="/Movies/Details/@movie.Id" class="btn btn-outline-dark btn-sm w-100 mt-3 rounded-pill fw-bold">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Context.Request.Method == "POST" && ViewBag.Error == null)
    {
        <div class="text-center py-5 fade-in">
            <div class="bg-white p-5 rounded-circle shadow-sm d-inline-block mb-3" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-search text-muted" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold text-dark">No Results Found</h5>
            <p class="text-muted small">Please verify the Movie IDs and try again.</p>
        </div>
    }
</div>

<script>
    function fillInput(ids) {
        document.getElementById('movieIdsInput').value = ids;
    }
</script>